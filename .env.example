# Password di accesso a GymBro (obbligatoria)
GYMBRO_PASSWORD=cambiami

# Porta su cui esporre l'app
GYMBRO_PORT=8080

# Cartella dei dati (database e foto)
GYMBRO_DATA=./data

# Cartella delle copie automatiche: meglio su un disco o volume diverso da quello dei dati
GYMBRO_BACKUPS=./backups
# Ora del backup giornaliero (HH:MM) e numero di copie del database da conservare (0 = disattivato)
BACKUP_TIME=03:00
BACKUP_KEEP=7

# Fuso orario per backup e promemoria
TZ=Europe/Rome

# Coach AI (facoltativo): senza chiave la sezione resta nascosta
ANTHROPIC_API_KEY=

# Contatto dichiarato ai servizi di notifica (facoltativo): mailto: oppure un indirizzo https
PUSH_CONTACT=mailto:gymbro@example.com
